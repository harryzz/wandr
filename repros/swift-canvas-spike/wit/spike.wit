// Task 114 P2 — Swift drives REAL wasi:canvas. The guest gets its canvas via the
// embedding handoff (get-context -> get-current-buffer + graphics), draws, and
// presents. Host implements wasi:canvas. P2 builds OpenCoreGraphics's CGContext
// over these verbs; this world is the import surface.
package wandr:swift-spike;

world swift-spike {
  import wasi:canvas/types@0.0.2;
  import wasi:canvas/draw@0.0.2;
  import wasi:canvas/embedding@0.0.2;
  // Host calls this to let the guest render one frame.
  export render: func();
}
