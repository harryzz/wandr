// Task 114 P2.2 — Swift renders on wandr-host. The guest exports the host-driven
// reactor surface (frame-handler + frame-pacing + a pointer stub) and imports
// wasi:canvas; on-frame it acquires the frame buffer via the embedding handoff,
// draws, and presents. Runs unchanged on wandr-host (skia wasi:canvas) — desktop
// dev loop, then device.
package wandr:swift-spike;

world swift-spike {
  import wasi:canvas/types@0.0.2;
  import wasi:canvas/draw@0.0.2;
  import wasi:canvas/embedding@0.0.2;
  import wasi:canvas/layout@0.0.2;
  import wasi:audio/pcm@0.0.1;
  import wandr:ui-shell/metrics@0.1.0;
  export wasi:input-handlers/frame-handler@0.0.2;
  export wasi:input-handlers/pointer-handler@0.0.2;
  export wandr:ui-shell/frame-pacing@0.1.0;
}
