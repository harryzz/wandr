// wandr_input_spike — task 80 Step 0. Standalone InputReader probe (cc_binary).
// Built in-tree on the AOSP host (a-03); soong resolves the inputflinger header
// graph. Deploy to ~/android/lineage/external/wandr_input_spike/ then: m wandr_input_spike
cc_binary {
    name: "wandr_input_spike",
    srcs: ["wandr_input_spike.cpp"],
    shared_libs: [
        "libinputreader",
        "libinputflinger_base",
        "libinput",
        "libutils",
        "liblog",
        "libbase",
        "libcutils",
    ],
    // InputReader's headers live in services/inputflinger/{include,reader/include}.
    include_dirs: [
        "frameworks/native/services/inputflinger/include",
        "frameworks/native/services/inputflinger/reader/include",
    ],
    cflags: ["-Wall", "-Wextra", "-Wno-unused-parameter"],
}
