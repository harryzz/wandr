package demo:cma;

/// Mirror of the production `wandr:signal/chat` shape after task 115 M2:
/// `start` is async-lifted and called BY THE HOST (a sync-lifted UI export may
/// not block on an async callee — wasmtime trap `CannotBlockSyncTask`);
/// `poll` stays a plain sync drain the UI calls per frame.
///
/// `fetch` / `fetch-chopped` are the phase-3 kill-gate: a live HTTPS GET over
/// the real wandr-reqwest p3 backend (Client→http1→tls_p3), and the same via
/// raw TlsStream with reads repeatedly dropped mid-select (cancellation-safety
/// torture — no byte may be lost).
interface chat {
  start: async func();
  poll: func() -> u32;
  fetch: async func(host: string) -> result<string, string>;
  fetch-chopped: async func(host: string) -> result<string, string>;
  /// Gate E: SPAWN the fetch as a background task and return immediately;
  /// the transport must then make progress across pump windows (the real
  /// engine's shape — gate D ran entirely inside one call_async).
  fetch-bg: async func(host: string);
  /// Result of the background fetch: none = still pending.
  fetch-bg-result: func() -> option<result<string, string>>;
  /// Gate F: the exact call path the Signal engine stalls on — WSS upgrade
  /// via the reqwest-websocket shim + first server frame. Inline (F1) and
  /// background-spawned, pump-driven (F2, result via fetch-bg-result).
  ws-probe: async func(host: string) -> result<string, string>;
  ws-probe-bg: async func(host: string);
  /// Step-bisect of the upgrade: connect / random / write / read-headers,
  /// with a phase line after each — pinpoints the wedge in one run.
  ws-steps: async func(host: string) -> result<string, string>;
  /// Keep-alive discriminator: HTTP/1.1 GET with the connection KEPT OPEN —
  /// isolates "guest stream read never completes on partial data while the
  /// stream stays open" (every passing probe so far ended with server EOF).
  ka-probe: async func(host: string) -> result<string, string>;
}

world engine {
  import wasi:clocks/monotonic-clock@0.3.0;
  export chat;
}
