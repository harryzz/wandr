@@ -0,0 +1,193 @@
+//! `external-aead` feature: an SRTP AEAD cipher whose raw AES-GCM seal/open is
+//! delegated to a caller-injected [`AeadProvider`] instead of the in-crate
+//! `aes-gcm`. All the SRTP framing (RFC 7714 key derivation, the 12-octet IV, the
+//! RTCP AAD) is identical to [`super::cipher_aead_aes_gcm`] — only the GCM block
+//! moves. wandr uses this to run the per-packet GCM on the device's hardware AES
+//! (which the wasm sandbox can't reach) via `wandr:crypto/aead`, but the trait is
+//! backend-agnostic: any AES-GCM implementation can be plugged in, on any platform.
+
+use byteorder::{BigEndian, ByteOrder};
+use bytes::BytesMut;
+
+use super::{Cipher, Kdf};
+use crate::key_derivation::*;
+use crate::protection_profile::ProtectionProfile;
+use shared::error::{Error, Result};
+use shared::marshal::MarshalSize;
+
+/// Factory for keyed AES-GCM contexts. Given a derived SRTP/SRTCP **session key**
+/// (16 B → AES-128-GCM, 32 B → AES-256-GCM), return a keyed [`AeadCtx`]. Called
+/// only at `Context` construction (twice: one SRTP, one SRTCP context).
+pub trait AeadProvider: Send + Sync {
+    fn new_key(&self, key: &[u8]) -> Box<dyn AeadCtx>;
+}
+
+/// A keyed AES-GCM context. `seal`/`open` use a 12-octet `nonce`, additional
+/// authenticated data `aad`, and standard AES-GCM framing (the 16-octet tag is
+/// appended to the ciphertext on `seal` and expected at the tail on `open`). The
+/// error type is `()` (dependency-free for the implementor): `Err` from `open` =
+/// auth failure → the SRTP layer drops the packet; `Err` from `seal` is fatal.
+pub trait AeadCtx: Send + Sync {
+    fn seal(&self, nonce: &[u8], aad: &[u8], plaintext: &[u8]) -> std::result::Result<Vec<u8>, ()>;
+    fn open(&self, nonce: &[u8], aad: &[u8], ciphertext: &[u8]) -> std::result::Result<Vec<u8>, ()>;
+}
+
+const RTCP_ENCRYPTION_FLAG: u8 = 0x80;
+
+/// AEAD SRTP cipher backed by an external [`AeadProvider`].
+pub(crate) struct CipherExternalAead {
+    profile: ProtectionProfile,
+    srtp_cipher: Box<dyn AeadCtx>,
+    srtcp_cipher: Box<dyn AeadCtx>,
+    srtp_session_salt: Vec<u8>,
+    srtcp_session_salt: Vec<u8>,
+}
+
+impl CipherExternalAead {
+    pub(crate) fn new(
+        profile: ProtectionProfile,
+        master_key: &[u8],
+        master_salt: &[u8],
+        provider: &dyn AeadProvider,
+    ) -> Result<CipherExternalAead> {
+        let kdf: Kdf = match profile {
+            ProtectionProfile::AeadAes128Gcm => aes_cm_key_derivation,
+            // AES_256_GCM uses AES_256_CM_PRF — RFC 7714 §11.
+            ProtectionProfile::AeadAes256Gcm => aes_256_cm_key_derivation,
+            _ => return Err(Error::Other("external-aead requires an AEAD GCM profile".to_string())),
+        };
+
+        let srtp_session_key =
+            kdf(LABEL_SRTP_ENCRYPTION, master_key, master_salt, 0, master_key.len())?;
+        let srtcp_session_key =
+            kdf(LABEL_SRTCP_ENCRYPTION, master_key, master_salt, 0, master_key.len())?;
+        let srtp_session_salt =
+            kdf(LABEL_SRTP_SALT, master_key, master_salt, 0, master_salt.len())?;
+        let srtcp_session_salt =
+            kdf(LABEL_SRTCP_SALT, master_key, master_salt, 0, master_salt.len())?;
+
+        Ok(CipherExternalAead {
+            profile,
+            srtp_cipher: provider.new_key(&srtp_session_key),
+            srtcp_cipher: provider.new_key(&srtcp_session_key),
+            srtp_session_salt,
+            srtcp_session_salt,
+        })
+    }
+
+    /// RFC 7714 §8.1 — the 12-octet SRTP IV (salt XOR ssrc||roc||seq).
+    fn rtp_initialization_vector(&self, header: &rtp::Header, roc: u32) -> Vec<u8> {
+        let mut iv = vec![0u8; 12];
+        BigEndian::write_u32(&mut iv[2..], header.ssrc);
+        BigEndian::write_u32(&mut iv[6..], roc);
+        BigEndian::write_u16(&mut iv[10..], header.sequence_number);
+        for (i, v) in iv.iter_mut().enumerate() {
+            *v ^= self.srtp_session_salt[i];
+        }
+        iv
+    }
+
+    /// RFC 7714 §9.1 — the 12-octet SRTCP IV.
+    fn rtcp_initialization_vector(&self, srtcp_index: usize, ssrc: u32) -> Vec<u8> {
+        let mut iv = vec![0u8; 12];
+        BigEndian::write_u32(&mut iv[2..], ssrc);
+        BigEndian::write_u32(&mut iv[8..], srtcp_index as u32);
+        for (i, v) in iv.iter_mut().enumerate() {
+            *v ^= self.srtcp_session_salt[i];
+        }
+        iv
+    }
+
+    /// RFC 7714 §17 — the SRTCP AAD (header || ESRTCP word).
+    fn rtcp_additional_authenticated_data(&self, rtcp_packet: &[u8], srtcp_index: usize) -> Vec<u8> {
+        let mut aad = vec![0u8; 12];
+        aad[..8].copy_from_slice(&rtcp_packet[..8]);
+        BigEndian::write_u32(&mut aad[8..], srtcp_index as u32);
+        aad[8] |= RTCP_ENCRYPTION_FLAG;
+        aad
+    }
+}
+
+impl Cipher for CipherExternalAead {
+    fn rtp_auth_tag_len(&self) -> usize {
+        self.profile.rtp_auth_tag_len()
+    }
+
+    fn rtcp_auth_tag_len(&self) -> usize {
+        self.profile.rtcp_auth_tag_len()
+    }
+
+    fn aead_auth_tag_len(&self) -> usize {
+        self.profile.aead_auth_tag_len()
+    }
+
+    fn encrypt_rtp(&mut self, payload: &[u8], header: &rtp::Header, roc: u32) -> Result<BytesMut> {
+        let header_len = header.marshal_size();
+        let mut writer = BytesMut::with_capacity(payload.len() + self.aead_auth_tag_len());
+        writer.extend_from_slice(&payload[..header_len]);
+
+        let nonce = self.rtp_initialization_vector(header, roc);
+        let encrypted = self
+            .srtp_cipher
+            .seal(&nonce, &writer, &payload[header_len..])
+            .map_err(|_| Error::Other("external-aead seal".to_string()))?;
+
+        writer.extend_from_slice(&encrypted);
+        Ok(writer)
+    }
+
+    fn decrypt_rtp(&mut self, ciphertext: &[u8], header: &rtp::Header, roc: u32) -> Result<BytesMut> {
+        if ciphertext.len() < self.aead_auth_tag_len() {
+            return Err(Error::ErrFailedToVerifyAuthTag);
+        }
+        let nonce = self.rtp_initialization_vector(header, roc);
+        let payload_offset = header.marshal_size();
+        let decrypted = self
+            .srtp_cipher
+            .open(&nonce, &ciphertext[..payload_offset], &ciphertext[payload_offset..])
+            .map_err(|_| Error::ErrFailedToVerifyAuthTag)?;
+
+        let mut writer = BytesMut::with_capacity(payload_offset + decrypted.len());
+        writer.extend_from_slice(&ciphertext[..payload_offset]);
+        writer.extend_from_slice(&decrypted);
+        Ok(writer)
+    }
+
+    fn encrypt_rtcp(&mut self, decrypted: &[u8], srtcp_index: usize, ssrc: u32) -> Result<BytesMut> {
+        let iv = self.rtcp_initialization_vector(srtcp_index, ssrc);
+        let aad = self.rtcp_additional_authenticated_data(decrypted, srtcp_index);
+        let encrypted = self
+            .srtcp_cipher
+            .seal(&iv, &aad, &decrypted[8..])
+            .map_err(|_| Error::Other("external-aead seal (rtcp)".to_string()))?;
+
+        let mut writer = BytesMut::with_capacity(encrypted.len() + aad.len());
+        writer.extend_from_slice(&decrypted[..8]);
+        writer.extend_from_slice(&encrypted);
+        writer.extend_from_slice(&aad[8..]);
+        Ok(writer)
+    }
+
+    fn decrypt_rtcp(&mut self, encrypted: &[u8], srtcp_index: usize, ssrc: u32) -> Result<BytesMut> {
+        if encrypted.len() < self.aead_auth_tag_len() + SRTCP_INDEX_SIZE {
+            return Err(Error::ErrFailedToVerifyAuthTag);
+        }
+        let nonce = self.rtcp_initialization_vector(srtcp_index, ssrc);
+        let aad = self.rtcp_additional_authenticated_data(encrypted, srtcp_index);
+        let decrypted = self
+            .srtcp_cipher
+            .open(&nonce, &aad, &encrypted[8..(encrypted.len() - SRTCP_INDEX_SIZE)])
+            .map_err(|_| Error::ErrFailedToVerifyAuthTag)?;
+
+        let mut writer = BytesMut::with_capacity(8 + decrypted.len());
+        writer.extend_from_slice(&encrypted[..8]);
+        writer.extend_from_slice(&decrypted);
+        Ok(writer)
+    }
+
+    fn get_rtcp_index(&self, input: &[u8]) -> usize {
+        let pos = input.len() - 4;
+        let val = BigEndian::read_u32(&input[pos..]);
+        (val & !((RTCP_ENCRYPTION_FLAG as u32) << 24)) as usize
+    }
+}
