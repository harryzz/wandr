// The launcher guest world (Phase B — fully new-style). Drawing + text via
// wasi:canvas@0.0.2; frames + taps via the wasi:input-handlers@0.0.2
// exports; pacing via wandr:ui-shell/frame-pacing; the launcher channel
// from wandr:chrome (the my:skiko-gfx slice's post-consolidation home).
// All interfaces live in deps/ — this package only declares the world.
package wandr:launcher-app@0.1.0;

world launcher-app {
    import wasi:canvas/types@0.0.2;
    import wasi:canvas/draw@0.0.2;
    import wasi:canvas/layout@0.0.2;
    import wasi:canvas/embedding@0.0.2;
    import wandr:chrome/launcher@0.1.0;
    export wasi:input-handlers/pointer-handler@0.0.2;
    export wasi:input-handlers/frame-handler@0.0.2;
    export wandr:ui-shell/frame-pacing@0.1.0;
}
