// Trimmed `my:skiko-gfx` WIT for the Rust status-bar guest (task 55).
// Same rationale as wandr.launcher's: the guest wit-bindgen rejects the
// canonical skiko-gfx.wit (matrix-3x3), so we redeclare just the subset
// used. `paint-attrs` + enums copied verbatim for structural matching.

package my:skiko-gfx@0.1.0;

interface status {
    clock-text:   func() -> string;
    battery-text: func() -> string;
}

interface renderer {
    enum pointer-kind { down, up, move, scroll }
    enum key-kind     { down, up }
    render-frame:          func(nanos: u64);
    on-pointer-event:      func(kind: pointer-kind, x: f32, y: f32);
    on-key-event:          func(kind: key-kind, key-code: u32);
    on-resize:             func(w: u32, h: u32);
    on-scheduled-callback: func(callback-id: u32);
    on-pointer-event-v2:   func(pointer-id: u32, kind: pointer-kind, x: f32, y: f32, pressure: f32);
    on-key-event-v2:       func(kind: key-kind, code-point: u32, key-id: u32);
    on-lifecycle-changed:  func(state: u32);
}

// Task 64 — optional on-demand-render hint (copied verbatim from the
// canonical skiko-gfx.wit).
interface frame-pacing {
    next-frame-delay: func() -> u32;
}

world statusbar-app {
    // Drawing + text via the wasi:canvas draft (second generate! path root).
    import wasi:canvas/types@0.0.1;
    import wasi:canvas/draw@0.0.1;
    import wasi:canvas/layout@0.0.1;
    import wasi:canvas/embedding@0.0.1;
    import status;
    // M3b — the notification feed (host-implemented; answered from the arbiter).
    // The interface lives in wit/deps/notify/ (package wandr:notify); the host
    // provides it via NotifyHost::add_to_linker.
    import wandr:notify/notify-feed@0.1.0;
    export renderer;
    export frame-pacing;
}
