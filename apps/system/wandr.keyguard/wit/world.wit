// The keyguard guest world (Phase B — fully new-style). Drawing + text via
// wasi:canvas@0.0.2; frames + the swipe gesture via the
// wasi:input-handlers@0.0.2 exports; pacing via wandr:ui-shell/frame-pacing;
// clock/battery from wandr:chrome/status (the my:skiko-gfx slice's
// post-consolidation home). All interfaces live in deps/ — this package
// only declares the world.
package wandr:keyguard-app@0.1.0;

world keyguard-app {
    import wasi:canvas/types@0.0.2;
    import wasi:canvas/draw@0.0.2;
    import wasi:canvas/layout@0.0.2;
    import wasi:canvas/embedding@0.0.2;
    import wandr:chrome/status@0.1.0;
    // M3 — the unlock channel to the arbiter (dep under wit/deps/keyguard/).
    import wandr:keyguard/keyguard@0.1.0;
    export wasi:input-handlers/pointer-handler@0.0.2;
    export wasi:input-handlers/frame-handler@0.0.2;
    export wandr:ui-shell/frame-pacing@0.1.0;
}
