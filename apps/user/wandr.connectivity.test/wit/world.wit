// The connectivity-test guest world: the trimmed `my:skiko-gfx` contract (verbatim
// from dioxus-canvas's `skiko_world!` — the canonical WIT's `matrix-3x3` is rejected
// by the guest wit-parser) PLUS the `wandr:events/incoming-handler` EXPORT (a dep
// under deps/events/). The guest is receive-only — it subscribes to `net.status`
// via `package.toml [events]` and renders each delivered event; it does not import
// `producer` (it never publishes). `wire!` binds the renderer/sink/IME over the
// skiko half.
package my:skiko-gfx@0.1.0;

interface ime {
    notify-editor-attached: func(
        input-type: string,
        hint: string,
        initial-text: string,
        selection-start: u32,
        selection-end: u32,
    );
    notify-editor-detached: func();
}

interface renderer {
    enum pointer-kind { down, up, move, scroll }
    enum key-kind     { down, up }
    render-frame:          func(nanos: u64);
    on-pointer-event:      func(kind: pointer-kind, x: f32, y: f32);
    on-key-event:          func(kind: key-kind, key-code: u32);
    on-resize:             func(w: u32, h: u32);
    on-scheduled-callback: func(callback-id: u32);
    on-pointer-event-v2:   func(pointer-id: u32, kind: pointer-kind, x: f32, y: f32, pressure: f32);
    on-key-event-v2:       func(kind: key-kind, code-point: u32, key-id: u32);
    on-lifecycle-changed:  func(state: u32);
}

interface frame-pacing {
    next-frame-delay: func() -> u32;
}

world connectivity-test-app {
    // Drawing comes from the wasi:canvas draft (separate
    // dioxus_canvas::wasi_canvas_bindings! generate).
    import ime;
    export renderer;
    export frame-pacing;
    // The event-bus receive side (host-implemented push; fanned by the arbiter
    // broker). Dep under deps/events/. Receive-only — no `producer` import.
    export wandr:events/incoming-handler@0.1.0;
}
