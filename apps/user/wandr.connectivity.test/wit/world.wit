// The connectivity-test guest world (Phase B): the wandr:ui-shell slice the
// dioxus-canvas backend consumes (ime import + shell-events/frame-pacing
// exports) plus the wandr:events receive leg. The app subscribes to topics
// via `package.toml [events]` and renders each delivered event; it does not
// import the producer side. Drawing + input come from dioxus-canvas's own
// wasi:canvas@0.0.2 / wasi:input-handlers@0.0.2 generates.
package wandr:ui-shell@0.1.0;

interface ime {
    notify-editor-attached: func(
        input-type: string,
        hint: string,
        initial-text: string,
        selection-start: u32,
        selection-end: u32,
    );
    notify-editor-detached: func();
}

interface lifecycle {
    enum state { initialized, created, started, resumed, paused, stopped, destroyed }
    get-state: func() -> state;
}

interface shell-events {
    use lifecycle.{state};
    on-scheduled-callback: func(callback-id: u32);
    on-lifecycle-changed:  func(new-state: state);
}

interface frame-pacing {
    next-frame-delay: func() -> u32;
}

world connectivity-test-app {
    import ime;
    export shell-events;
    export frame-pacing;
    // Generic event bus delivery (task 90 — host socket bridge to the arbiter
    // broker). Dep under deps/events/. Receive-only — no `producer` import.
    export wandr:events/incoming-handler@0.1.0;
}
