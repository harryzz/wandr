// wandr.navidrome — a Subsonic/OpenSubsonic (Navidrome) music client. It talks the
// Subsonic REST API over HTTPS (browse/search + stream) and plays the returned audio
// through the SHIPPED engine's audio path (`engine::open_audio_sync` → Demux::Audio →
// symphonia demux+decode → wasi:audio + the A/V-master clock + seek).
//
// EXPORTS-ONLY (like wandr.dash / wandr.flac.test): audio/canvas IMPORTS live in
// wandr-media-engine's own imports-only bindgen; wasi:tls/sockets come from
// wandr-reqwest, granted per-app by the host.
package wandr:navidrome@0.1.0;

world navidrome-app {
    export wasi:input-handlers/frame-handler@0.0.2;
    export wasi:input-handlers/key-handler@0.0.2;
    export wasi:input-handlers/pointer-handler@0.0.2;
    export wandr:ui-shell/frame-pacing@0.1.0;
    export wandr:background/background@0.1.0;
}
