// wandr.alarm.test — the wandr:alarm timed-wake test guest (Arbiter Inc. 3c).
//
// Was a `my:skiko-gfx` guest (its own trimmed canvas + renderer + frame-pacing
// copy). That whole package RETIRED in Phase C (task 105): the host neither
// links `my:skiko-gfx/canvas` (instantiation fails, "surface-width
// implementation is missing") nor calls `renderer.render-frame` (UI guests are
// driven through `wasi:input-handlers/frame-handler` — input.rs::dispatch_frame).
// Migrated to the live contracts, same as wandr.video.player (task 117 M2).
package wandr:alarm-test-app@0.1.0;

world alarm-test-app {
    // Drawing (replaces the trimmed my:skiko-gfx/canvas). `embedding` is not
    // optional: the host composites and swaps the frame inside `context.present`,
    // so a guest that never presents shows nothing.
    import wasi:canvas/types@0.0.2;
    import wasi:canvas/draw@0.0.2;
    import wasi:canvas/embedding@0.0.2;

    import wandr:alarm/scheduler@0.1.0;

    // Render driving (replaces the retired my:skiko-gfx/renderer + frame-pacing).
    export wasi:input-handlers/frame-handler@0.0.2;
    export wandr:ui-shell/frame-pacing@0.1.0;

    export wandr:alarm/alarm-handler@0.1.0;
    // M2 — also a background-service: the host calls bg-tick while we're
    // backgrounded (in place of on-frame) so we can verify the pump fires.
    export wandr:background/background@0.1.0;
    // M3 — notifications: post one + receive taps (on-notification-click).
    import wandr:notify/notifier@0.1.0;
    export wandr:notify/notify-handler@0.1.0;
    // wandr-arbiter-audio M2 — audio focus: request gain on first frame, receive
    // on-focus-changed when another app takes focus.
    import wandr:audio-focus/focus@0.1.0;
    export wandr:audio-focus/focus-handler@0.1.0;
}
