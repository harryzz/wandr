// wandr:chrome — system-chrome services factored out of my:skiko-gfx
// (launcher/status feeds, display control, pointer icon).
package wandr:chrome@0.1.0;

interface launcher {
    /// Installed user-launchable apps, newline-delimited, one per line as
    /// `app-id` + TAB + `label`. Empty string if none / unavailable.
    /// Sourced from the host's install-dir scan (no PackageManager).
    list-apps: func() -> string;

    /// Ask the arbiter to launch (or foreground, if already running) the
    /// app with this id. Fire-and-forget — the arbiter foregrounds it,
    /// demoting the launcher to the background.
    launch-app: func(app-id: string);

    // ── Shell navigation (task 56 taskbar) ────────────────────────────
    /// Foreground the home/launcher app (arbiter `go-home`).
    go-home: func();
    /// Route an Android-style Back key to the foreground app (arbiter
    /// `back`). Apps opt in via a back handler; unhandled = no-op.
    go-back: func();
    /// Switch to the next running user app (arbiter `cycle-task`) — a
    /// minimal recents/task-switch.
    recents: func();
}

interface status {
    /// Local wall-clock as "HH:MM" (24h). Empty on error.
    clock-text: func() -> string;
    /// Battery as "NN%" (e.g. "100%"), or "" if unavailable.
    battery-text: func() -> string;
    /// Status-bar strip height in physical px — the single source of
    /// truth for both the overlay surface and any consumer's top inset
    /// (task 55). Tunable via WANDR_STATUSBAR_PX.
    bar-height: func() -> u32;
}

interface display {
    /// Width/height in physical px.
    record size { width: u32, height: u32 }
    /// Coarse device orientation, derived from the dihedral rotation the
    /// host applies. The IME reads it to pick its per-orientation layout.
    enum orientation { portrait, landscape }

    /// The whole panel at the current orientation, no insets — for full-bleed
    /// needs (wallpaper, splash).
    display-size: func() -> size;
    /// `display` minus the chrome strips (status bar + task bar). What a normal
    /// app lays out to; equals `display` for immersive / no-chrome apps.
    content-size: func() -> size;
    /// `content` minus the soft keyboard — the region a focused editor must
    /// stay within. Transient (shrinks when the keyboard shows); equals
    /// `content` when the keyboard is hidden. Same value as the legacy
    /// `canvas.surface-width/height` a fullscreen guest already lays out to.
    safe-size: func() -> size;
    /// Portrait vs landscape at the current orientation. (Named distinctly
    /// from the `orientation` enum — WIT items share one name namespace.)
    current-orientation: func() -> orientation;
}

interface now-playing {
    /// W3C MediaSessionPlaybackState (mirror of wasi:media-session).
    enum playback-state { none, paused, playing }

    /// W3C MediaSessionAction subset the transport surfaces (lockscreen /
    /// status bar) can issue. Routed by the arbiter to the active session's
    /// `wasi:media-session/session-handler.on-action`.
    enum action {
        play, pause, stop, seek-to,
        seek-forward, seek-backward,
        previous-track, next-track,
    }

    /// Now-playing snapshot the system chrome renders. `position-s` is the
    /// guest's last-published playhead; `has-artwork` tells the surfacer
    /// whether `artwork()` is worth calling (art bytes are large, so they're
    /// fetched on demand rather than on every poll).
    record now-playing-info {
        app-id: string,
        title: string,
        artist: string,
        album: string,
        state: playback-state,
        duration-s: f64,
        position-s: f64,
        has-artwork: bool,
    }

    /// The active media session's now-playing, or none if nothing is playing.
    /// Host-implemented: answered live from the arbiter (it owns the session
    /// state), like `notify-feed.list-active`.
    get: func() -> option<now-playing-info>;

    /// The active session's artwork bytes (a decodable image: png/jpeg/webp),
    /// or none. Fetched on demand only when `has-artwork` is set.
    artwork: func() -> option<list<u8>>;

    /// The user tapped a transport control. The host forwards it to the
    /// arbiter, which delivers `on-action` to the active session's guest.
    /// `seek-time-s` carries the target for `seek-to` / the offset for
    /// seek-forward/backward (none = the guest's default step).
    send-action: func(act: action, seek-time-s: option<f64>);
}

interface pointer-icon {
    enum kind {
        default, text, hand, crosshair, wait, help, progress,
        not-allowed, grab, grabbing, copy, %move,
        resize-ns, resize-ew, resize-nesw, resize-nwse,
        all-scroll, zoom-in, zoom-out
    }
    /// Request a cursor change. May silently no-op if the host device
    /// has no cursor or the requested icon isn't supported.
    set: func(kind: kind);
}

world chrome-imports {
    import launcher;
    import status;
    import display;
    import pointer-icon;
    import now-playing;
}
