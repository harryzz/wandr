// wandr.video.test guest world: a wasi:cli command (fn main provides cli/run on the
// wasm32-wasip2 target) that imports the wandr:video host interfaces it tests.
package wandr:video-test;

world video-test {
    import wasi:video-codec/types@0.0.1;
    import wasi:video-codec/decoder@0.0.1;
    import wandr:video/present@0.1.0;         // decode-to-surface (attach for AUTO)
    import wandr:video/capture-encode@0.1.0;  // fused call-encoder (camera+encode+PiP)
    import wandr:video-diag/diag@0.1.0;       // decoded-frames
}
