// The taskmanager-ui guest world: the trimmed `my:skiko-gfx` contract (verbatim
// from dioxus-canvas's `skiko_world!` — the canonical WIT's `matrix-3x3` is
// rejected by the guest wit-parser) PLUS the `wandr:task-manager/task-manager`
// import (a dep under deps/task-manager/). One world → one generate! → no
// `_rt`/`cabi_realloc` conflict. `wire!` binds the renderer/sink/IME over the
// skiko half.
package my:skiko-gfx@0.1.0;

interface ime {
    notify-editor-attached: func(
        input-type: string,
        hint: string,
        initial-text: string,
        selection-start: u32,
        selection-end: u32,
    );
    notify-editor-detached: func();
}

interface renderer {
    enum pointer-kind { down, up, move, scroll }
    enum key-kind     { down, up }
    render-frame:          func(nanos: u64);
    on-pointer-event:      func(kind: pointer-kind, x: f32, y: f32);
    on-key-event:          func(kind: key-kind, key-code: u32);
    on-resize:             func(w: u32, h: u32);
    on-scheduled-callback: func(callback-id: u32);
    on-pointer-event-v2:   func(pointer-id: u32, kind: pointer-kind, x: f32, y: f32, pressure: f32);
    on-key-event-v2:       func(kind: key-kind, code-point: u32, key-id: u32);
    on-lifecycle-changed:  func(state: u32);
}

interface frame-pacing {
    next-frame-delay: func() -> u32;
}

world taskmanager-ui-app {
    // Drawing comes from the wasi:canvas draft (separate
    // dioxus_canvas::wasi_canvas_bindings! generate) — this world keeps
    // only the wandr platform bits + the app's own imports/exports.
    import ime;
    // The running-apps / task-manager interface (host-implemented; forwarded to
    // the arbiter + enriched with /proc). Dep under deps/task-manager/.
    import wandr:task-manager/task-manager@0.1.0;
    export renderer;
    export frame-pacing;
}
