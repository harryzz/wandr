// wandr.video.player — UI reactor world (task 117 M2 stage 2, on-screen proof).
//
// Converted from a wasi:cli command because `--run-once` guests are SURFACELESS:
// the host stores decoded frames but never runs composite_video_surfaces, so
// nothing is displayed and the SCHEDULED queue behind present(at-ns) is never
// drained. A UI reactor has a render loop, which is what actually puts video on
// screen. (--run-once is a deliberate special case and is left untouched.)
package wandr:video-player-app@0.1.0;

world video-player-app {
    // The playback lane under test (task 117 M2).
    import wandr:video/decoder@0.1.0;

    // wasi:canvas is REQUIRED even though this app draws nothing but a black
    // background. On desktop the host composites video surfaces inside
    // `canvas/embedding.context.present()` (wasi_canvas_002_impl.rs) — the guest's
    // present IS the frame. A guest that imports no canvas never presents, so the
    // decoded frames go nowhere and the window stays blank. (Stage-2 finding:
    // decode-to-surface is not self-driving; it rides the guest's canvas present.)
    import wasi:canvas/types@0.0.2;
    import wasi:canvas/draw@0.0.2;
    import wasi:canvas/layout@0.0.2;  // subtitle text layout (host-owned fonts)
    import wasi:canvas/embedding@0.0.2;
    //
    // The host drives UI guests through `wasi:input-handlers/frame-handler`
    // (input.rs `dispatch_frame`). The `my:skiko-gfx/renderer.render-frame` this
    // world used to export was RETIRED in Phase C (task 105) — the host never
    // calls it, so the app ran but was never ticked.
    export wasi:input-handlers/frame-handler@0.0.2;
    // Keys switch the decoder between hardware and software AT RUNTIME (H/S/N),
    // which is the only way to A/B them without a rebuild — and the guest half of
    // what `--list-codecs` + WANDR_VIDEO_BACKEND do for the operator.
    export wasi:input-handlers/key-handler@0.0.2;
    export wandr:ui-shell/frame-pacing@0.1.0;
}
