// wandr.ktcanvas.test — Stage 1 of the Kotlin wasi:canvas migration.
//
// A bare (non-Compose) Kotlin/Wasm guest whose bindings are GENERATED by
// the JetBrains Kotlin wit-bindgen fork (github.com/Kotlin/wit-bindgen,
// branch `kotlin`, pinned in build.sh) — validating every canonical-ABI
// shape the future skiko port needs: spilled paint records, strings,
// list<tuple> gradient stops, list<record> returns (paragraph.lines),
// imported resources with explicit drop, and the canvas-context frame
// bracket. Frames arrive via the wasi:input-handlers 0.0.2
// skiko-ui world (frame driving + input); drawing goes EXCLUSIVELY
// through wasi:canvas.
package wandr:ktcanvas-test;

world ktcanvas-test {
    import wasi:canvas/types@0.0.2;
    import wasi:canvas/draw@0.0.2;
    import wasi:canvas/layout@0.0.2;
    import wasi:canvas/scene@0.0.2;
    import wasi:canvas/embedding@0.0.2;

    /// Phase B: frames via the 0.0.2 frame-handler (the legacy
    /// my:skiko-gfx/renderer export is retired).
    export wasi:input-handlers/frame-handler@0.0.2;
    /// 0.0.2 pointer export — validates the union record (device/button/
    /// buttons-flags/enter-leave) through the Kotlin generator + the
    /// host's 002>001>legacy routing.
    export wasi:input-handlers/pointer-handler@0.0.2;
}
