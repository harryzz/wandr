// wandr:notify — M4. Signal imports `notifier` (raise/clear on inbound) + exports
// `notify-handler` (open the thread on tap).
package wandr:notify@0.1.0;

interface notifier {
    post: func(id: u64, title: string, body: string);
    cancel: func(id: u64);
}

interface notify-handler {
    on-notification-click: func(id: u64);
}
