// The engine contract this consumer imports (mirror of ../../../engine/wit).
package wandr:signal@0.1.0;

interface chat {
  enum delivery { sending, sent, delivered, read }
  record attachment { content-type: string, data: list<u8>, width: u32, height: u32 }
  enum call-log { out-answered, out-missed, out-busy, in-answered, in-missed, in-declined }
  record message { id: u64, sender: string, text: string, ts: u64, outgoing: bool, thread: string, status: delivery, reactions: string, attachments: list<attachment>, call: option<call-log> }
  record contact { id: string, name: string, phone: option<string>, inbox-position: u32, avatar: option<list<u8>> }
  record group { id: string, title: string, members: list<string>, avatar: option<list<u8>> }
  record profile { given-name: string, family-name: string, about: string, about-emoji: string, phone: string, avatar: option<list<u8>> }
  record delivery-status { id: u64, status: delivery }
  record reaction-update { id: u64, reactions: string }
  enum call-state { idle, outgoing, ringing, connecting, connected, ended }
  variant event {
    message(message),
    link-url(string),
    linked(string),
    connected,
    disconnected,
    contacts-updated(u32),
    groups-updated(u32),
    status-changed(delivery-status),
    reaction-changed(reaction-update),
    profile-updated,
    call-incoming(string),
    call-state-changed(call-state),
  }
  init: func();
  poll-events: func() -> list<event>;
  send: func(thread: string, text: string) -> result<_, string>;
  mark-read: func(thread: string);
  history: func() -> list<message>;
  contacts: func() -> list<contact>;
  sync-contacts: func();
  groups: func() -> list<group>;
  sync-groups: func();
  state: func() -> string;
  account-id: func() -> string;
  my-profile: func() -> profile;
  sync-profile: func();
  place-call: func(thread: string) -> result<_, string>;
  accept-call: func();
  hangup-call: func();
  call-status: func() -> call-state;
  call-peer: func() -> string;
}
