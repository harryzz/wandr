// The signal-ui guest world: the trimmed `my:skiko-gfx` contract (verbatim from
// dioxus-canvas's `skiko_world!` — the canonical WIT's `matrix-3x3` is rejected
// by the guest wit-parser) PLUS the engine's `wandr:signal/chat` import (a dep
// under deps/signal/). One world → one generate! → no `_rt`/`cabi_realloc`
// conflict. `wire!` binds the renderer/sink/IME over the skiko half.
package my:skiko-gfx@0.1.0;

interface ime {
    notify-editor-attached: func(
        input-type: string,
        hint: string,
        initial-text: string,
        selection-start: u32,
        selection-end: u32,
    );
    notify-editor-detached: func();
}

interface renderer {
    enum pointer-kind { down, up, move, scroll }
    enum key-kind     { down, up }
    render-frame:          func(nanos: u64);
    on-pointer-event:      func(kind: pointer-kind, x: f32, y: f32);
    on-key-event:          func(kind: key-kind, key-code: u32);
    on-resize:             func(w: u32, h: u32);
    on-scheduled-callback: func(callback-id: u32);
    on-pointer-event-v2:   func(pointer-id: u32, kind: pointer-kind, x: f32, y: f32, pressure: f32);
    on-key-event-v2:       func(kind: key-kind, code-point: u32, key-id: u32);
    on-lifecycle-changed:  func(state: u32);
}

interface frame-pacing {
    next-frame-delay: func() -> u32;
}

// Subset of the canonical `status` interface — just the host's local wall-clock,
// used to derive the device timezone offset so message timestamps render in local
// time. The host links the full skiko-ui world, so importing this subset resolves.
interface status {
    clock-text: func() -> string;
}

world signal-ui-app {
    // Drawing comes from the wasi:canvas draft (separate
    // dioxus_canvas::wasi_canvas_bindings! generate).
    import ime;
    import status;
    import wandr:signal/chat@0.1.0;
    export renderer;
    export frame-pacing;
    // M4 (Signal background-receipt) — keep the engine pumping while backgrounded
    // (bg-tick instead of render), raise notifications on inbound, re-wake if
    // killed (keep-alive alarm), and open the right thread on a notification tap.
    export wandr:background/background@0.1.0;
    import wandr:notify/notifier@0.1.0;
    export wandr:notify/notify-handler@0.1.0;
    import wandr:alarm/scheduler@0.1.0;
    export wandr:alarm/alarm-handler@0.1.0;
    // In-call audio controls (route / volume / mute) — the call-controls panel.
    import wandr:audio-focus/controls@0.1.0;
}
