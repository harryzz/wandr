// The signal-ui guest world (Phase B): the wandr:ui-shell slice the
// dioxus-canvas backend consumes (ime import + shell-events/frame-pacing
// exports) PLUS the engine's `wandr:signal/chat` import (a dep under
// deps/signal/) and the background-receipt/notify/alarm/audio legs. One
// world → one generate! → no `_rt`/`cabi_realloc` conflict. Drawing + input
// come from dioxus-canvas's own wasi:canvas@0.0.2 / wasi:input-handlers@0.0.2
// generates. The host clock (timezone-local timestamps) now comes from
// `wandr:chrome/status` (deps/chrome/) — its post-consolidation home.
package wandr:ui-shell@0.1.0;

interface ime {
    notify-editor-attached: func(
        input-type: string,
        hint: string,
        initial-text: string,
        selection-start: u32,
        selection-end: u32,
    );
    notify-editor-detached: func();
}

interface lifecycle {
    enum state { initialized, created, started, resumed, paused, stopped, destroyed }
    get-state: func() -> state;
}

interface shell-events {
    use lifecycle.{state};
    on-scheduled-callback: func(callback-id: u32);
    on-lifecycle-changed:  func(new-state: state);
}

interface frame-pacing {
    next-frame-delay: func() -> u32;
}

// Display metrics (wandr:ui-shell/metrics) — the host reports the real display
// density so the UI scales to the panel/window instead of a hardcoded factor.
interface metrics {
    get-density:    func() -> f32;
    get-font-scale: func() -> f32;
    get-dpi:        func() -> u32;
}

world signal-ui-app {
    import ime;
    import metrics;
    import wandr:chrome/status@0.1.0;
    import wandr:signal/chat@0.1.0;
    export shell-events;
    export frame-pacing;
    // M4 (Signal background-receipt) — keep the engine pumping while backgrounded
    // (bg-tick instead of render), raise notifications on inbound, re-wake if
    // killed (keep-alive alarm), and open the right thread on a notification tap.
    export wandr:background/background@0.1.0;
    import wandr:notify/notifier@0.1.0;
    export wandr:notify/notify-handler@0.1.0;
    import wandr:alarm/scheduler@0.1.0;
    export wandr:alarm/alarm-handler@0.1.0;
    // In-call audio controls (route / volume / mute) — the call-controls panel.
    import wandr:audio-focus/controls@0.1.0;
}
