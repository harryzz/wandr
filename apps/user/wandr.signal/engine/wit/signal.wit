package wandr:signal@0.1.0;

/// The toolkit-agnostic contract between the Signal engine (this component, which
/// owns the network/protocol/persistence) and any UI that drives it. The UI calls
/// `init` once, then `poll-events` each frame to pump the network and drain what
/// happened; `send` to queue an outgoing text; `history`/`state` for snapshots.
interface chat {
  /// Delivery state of an outgoing message (incoming messages are always `sent`).
  /// Monotonic: sending → sent (server accepted) → delivered (recipient device
  /// got it) → read (recipient opened it; only if they share read receipts).
  enum delivery {
    sending,
    sent,
    delivered,
    read,
  }

  /// A media attachment on a message (v1: images). `data` is the decrypted
  /// bytes (the engine downloaded + decrypted from the CDN); `width`/`height`
  /// are the source pixel dimensions (0 = unknown) so the UI can keep aspect.
  record attachment {
    content-type: string,
    data: list<u8>,
    width: u32,
    height: u32,
  }

  /// A 1:1 voice-call history entry (direction + outcome) shown inline in the
  /// conversation. `None` on a normal message ⇒ it's a text/attachment message.
  enum call-log {
    out-answered,   // we called, connected
    out-missed,     // we called, no answer / canceled
    out-busy,       // we called, peer was busy
    in-answered,    // they called, we answered
    in-missed,      // they called, we didn't answer
    in-declined,    // they called, we declined
  }

  /// One stored conversation message. `id` is engine-assigned and stable.
  record message {
    id: u64,
    sender: string,
    text: string,
    ts: u64,
    outgoing: bool,
    /// Conversation key: the peer ACI (1:1) or the group master key b64 (group).
    thread: string,
    /// Delivery state (meaningful for outgoing; `sent` for incoming).
    status: delivery,
    /// Emoji reactions on this message — the distinct emojis concatenated
    /// (e.g. "❤️👍"). Empty when no one has reacted.
    reactions: string,
    /// Media attachments (v1: images), decrypted and ready to render. Empty for
    /// a text-only message.
    attachments: list<attachment>,
    /// Set when this entry is a call-history record (renders as a call log, not a
    /// bubble); `none` for a normal text/attachment message.
    call: option<call-log>,
  }

  /// An outgoing message's delivery state advanced (delivery/read receipt).
  record delivery-status {
    id: u64,
    status: delivery,
  }

  /// State of the current 1:1 voice call (audio only). `idle` = no call.
  /// outgoing → connecting → connected (we placed it); ringing → connecting →
  /// connected (we received + accepted it); `ended` = hung up / declined / busy.
  enum call-state {
    idle,
    outgoing,
    ringing,
    connecting,
    connected,
    ended,
  }

  /// A message's emoji reactions changed (someone added/removed a reaction).
  record reaction-update {
    id: u64,
    reactions: string,
  }

  /// A user from the primary device's contact list (Signal contacts-sync).
  record contact {
    /// ACI (account UUID) string — the stable identity, matches `message.sender`.
    id: string,
    name: string,
    /// E.164 phone number, if the contact has one shared.
    phone: option<string>,
    /// Ordering hint from the primary's address book.
    inbox-position: u32,
    /// Encoded avatar image (JPEG/PNG bytes), if the contact has one.
    avatar: option<list<u8>>,
  }

  /// Our own Signal profile (fetched from the profile service + decrypted with
  /// our profile key). All fields are carried for future use; the UI currently
  /// shows the name, avatar, and phone.
  record profile {
    given-name: string,
    family-name: string,
    about: string,
    about-emoji: string,
    /// E.164 phone number (from the account, not the profile).
    phone: string,
    /// Decrypted avatar image bytes, if the profile has one.
    avatar: option<list<u8>>,
  }

  /// A Signal group (Groups v2), fetched via the storage service.
  record group {
    /// hex of the group master key — the stable group identity.
    id: string,
    title: string,
    /// Member display names (contact name where known, else ACI).
    members: list<string>,
    /// Decrypted group avatar (JPEG bytes from the group CDN), if set.
    avatar: option<list<u8>>,
  }

  /// Something the engine produced since the last `poll-events`.
  variant event {
    /// A new message (incoming, or the local echo of an outgoing send).
    message(message),
    /// Device-link QR payload — render this as a QR for the user to scan.
    link-url(string),
    /// Linking finished; carries the linked phone number.
    linked(string),
    /// The authenticated message socket is open.
    connected,
    /// The socket closed or setup failed (see `state` for detail).
    disconnected,
    /// The contact list was fetched/updated (read it via `contacts`).
    contacts-updated(u32),
    /// The group list was fetched/updated (read it via `groups`).
    groups-updated(u32),
    /// An outgoing message's delivery state advanced (sent/delivered/read).
    status-changed(delivery-status),
    /// A message's emoji reactions changed.
    reaction-changed(reaction-update),
    /// Our own profile was fetched/updated (read it via `my-profile`).
    profile-updated,
    /// An incoming 1:1 call is ringing — carries the caller's ACI (the thread to
    /// show the in-call UI for). Accept with `accept-call`, reject with `hangup-call`.
    call-incoming(string),
    /// The current call's state changed (read detail via `call-status`/`call-peer`).
    call-state-changed(call-state),
  }

  /// Start the engine: load saved account + history, then link (first run) or
  /// resume in the background. Idempotent. Returns immediately — progress is
  /// surfaced through later `poll-events`.
  init: func();

  /// Pump the network without blocking and return everything that happened since
  /// the previous call. Call once per UI frame.
  poll-events: func() -> list<event>;

  /// Mark a conversation as read: send a read receipt for every message we've
  /// received in `thread` (to each sender), so the other side sees "read". Also
  /// sends to the senders of group messages. Idempotent — already-acked messages
  /// are skipped. Call when the user opens/views the thread.
  mark-read: func(thread: string);

  /// Queue an outgoing text to `thread` (a peer ACI for 1:1, or a group master
  /// key b64 for a group; empty → Note-to-Self). Echoed locally right away; sent
  /// over the wire within a couple hundred ms. Returns `Ok` once queued.
  send: func(thread: string, text: string) -> result<_, string>;

  /// The full conversation so far.
  history: func() -> list<message>;

  /// The contact list fetched from the primary device (persisted to /state).
  contacts: func() -> list<contact>;

  /// Ask the primary device for a fresh contacts sync. Also done automatically
  /// once on connect; call this to refresh on demand. Non-blocking — results
  /// arrive later via a `contacts-updated` event + `contacts`.
  sync-contacts: func();

  /// The group list (Groups v2) fetched via the storage service (persisted to
  /// /state). Empty until a `groups-updated` event fires.
  groups: func() -> list<group>;

  /// Re-fetch groups from the storage service. Also done once on connect (if the
  /// account has a master key — needs a link captured post-task-69). Non-blocking.
  sync-groups: func();

  /// A short human-readable status: "linking" | "linked" | "connected" |
  /// "error: …".
  state: func() -> string;

  /// This account's own ACI (lowercase uuid), or "" until linked. Lets a UI
  /// label the Note-to-Self thread (whose id is this account's own ACI).
  account-id: func() -> string;

  /// Our own Signal profile (name/avatar/about/phone). All-empty until fetched
  /// (a `profile-updated` event fires when it arrives). Persisted across runs.
  my-profile: func() -> profile;

  /// Re-fetch our own profile from the profile service. Also done once on
  /// connect. Non-blocking — the result arrives via `profile-updated`.
  sync-profile: func();

  /// Place a 1:1 audio call to `thread` (a peer ACI). Non-blocking — progress
  /// surfaces via `call-state-changed` events + `call-status`. Errors if a call
  /// is already active.
  place-call: func(thread: string) -> result<_, string>;

  /// Accept the ringing incoming call (no-op if nothing is ringing).
  accept-call: func();

  /// Hang up / decline the current or ringing call (no-op if no call).
  hangup-call: func();

  /// The current 1:1 call state.
  call-status: func() -> call-state;

  /// The peer ACI on the current/ringing call, or "" when idle.
  call-peer: func() -> string;
}

/// The engine half of the Signal app. wasi imports (sockets/tls/io/fs/random/
/// clocks) are supplied by the wasm32-wasip2 target; only the chat export is
/// declared here.
world signal-engine {
  export chat;
  /// Mic capture + AAudio playback for live calls (Phase 2b-ii). Host-provided
  /// (skiko-gfx); after `wac plug`, this remains a host import of the composite.
  import my:skiko-gfx/audio@0.1.0;
  /// Drive the ringer + comms session on wandr-arbiter-audio (host-forwarded).
  import wandr:audio-focus/focus@0.1.0;
  /// Read the current call route (earpiece/speaker) so the call loop can re-open
  /// the output track when the user toggles it — the route binds at track open.
  import wandr:audio-focus/controls@0.1.0;
}
