// wandr.jellyfin — task 119 Part A. A REAL streaming client (not the contract
// probe that wandr.video.player is): it authenticates to a Jellyfin server over
// HTTPS (Quick Connect), browses the library, negotiates DirectPlay, and plays
// the server's original bytes through the SHIPPED pipeline unchanged —
//
//   guest: HTTPS range-fetch (wandr-reqwest/wasi:tls) -> demux (mp4)
//   host:  wandr:video/decoder (GStreamer) -> present(at-ns)
//   audio: guest-side Symphonia -> wasi:audio/pcm; position() = A/V master clock
//
// This world FUSES two shipped precedents:
//   * wandr.video.player — canvas + input-handlers + frame-pacing + video/decoder
//     (render loop + decode-to-surface).
//   * wandr.audio.player — wasi:audio/pcm + wandr:background (async bg-tick engine
//     that runs HTTPS through reqwest's p3-async wasi:tls).
//
// The wasi:tls / wasi:sockets imports the HTTPS needs are NOT declared here: they
// come from wandr-reqwest's own bindgen world and are linked for every app by the
// host (app_loader.rs signal_tls::add_to_linker + grant_network). Same as
// wandr.audio.player, whose world likewise never names wasi:tls.
package wandr:jellyfin@0.1.0;

world jellyfin-app {
    // ---- the playback lane (host GStreamer decode -> present) ----
    import wandr:video/decoder@0.1.0;

    // ---- guest-side audio decode -> host device; position() is the A/V clock ----
    import wasi:audio/pcm@0.0.1;

    // ---- UI: browse list + player overlay drawn guest-side over the video ----
    // Required even to show a black background — the host composites video
    // surfaces inside embedding.context.present(); a guest that never presents
    // shows nothing (see wandr.video.player world note).
    import wasi:canvas/types@0.0.2;
    import wasi:canvas/draw@0.0.2;
    import wasi:canvas/layout@0.0.2;   // text layout w/ host-owned fonts (titles, subtitles)
    import wasi:canvas/embedding@0.0.2;

    // ---- host drives UI guests through frame-handler; keys + pointer navigate ----
    export wasi:input-handlers/frame-handler@0.0.2;
    export wasi:input-handlers/key-handler@0.0.2;
    export wasi:input-handlers/pointer-handler@0.0.2;  // click-to-select + scroll
    export wandr:ui-shell/frame-pacing@0.1.0;

    // ---- the async network+decode engine (runs render-independently) ----
    // bg-tick is async-lifted, which is what lets it .await reqwest; the host
    // pumps it every tick on desktop (lib.rs bg_tick_at), before render.
    export wandr:background/background@0.1.0;
}
