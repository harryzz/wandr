package wandr:app@0.1.0;

/// wandr-app's world — adds the cross-app `wandr:markdown/renderer`
/// import on top of the canonical skiko-ui interfaces. Including
/// `skiko-ui` brings the full Compose render contract; we just add
/// the markdown import on top.
world wandr-app {
    include my:skiko-gfx/skiko-ui@0.1.0;
    import wandr:markdown/renderer@0.1.0;
    import wandr:emoji/picker@0.1.0;
    import wandr:fonts/loader@0.1.0;
    // Task 102 stage 2 — skiko's geometry/transform/clip/shader path runs on
    // the wasi:canvas draft when WasiCanvasBackend.enabled (Main.kt flips it);
    // text/images/pictures/drawables stay on the my:skiko-gfx canvas. Both
    // interface sets are always-linked host-side over the same SkiaRenderer.
    import wasi:canvas/types@0.0.1;
    import wasi:canvas/draw@0.0.1;
    import wasi:canvas/layout@0.0.1;
    import wasi:canvas/embedding@0.0.1;
    // Task 64 — optional on-demand-render hint. Opt-in export (not part of
    // skiko-ui) so the host can gate render-frame; see frame-pacing in the
    // skiko-gfx deps + RendererExports.kt's @WasmExport.
    export my:skiko-gfx/frame-pacing@0.1.0;
    // wasi:input-handlers migration — the host routes input/frame EXCLUSIVELY
    // to these once bound (legacy renderer verbs stay exported for
    // lifecycle/scheduled-callback + as the contract baseline). The key
    // handler receives records-with-strings: safe per the lift-before-alloc
    // contract (repros/kt-export-record-spike, 100k/100k JIT+AOT).
    export wasi:input-handlers/pointer-handler@0.0.1;
    // key-handler requires the wandr stdlib fix (invokeOnExportedFunctionExit
    // skipped while canonical-ABI realloc memory is pending) — see
    // InputHandlerExports.kt.
    export wasi:input-handlers/key-handler@0.0.1;
    export wasi:input-handlers/frame-handler@0.0.1;
}
