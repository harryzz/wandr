// Generation-only world for wandr-app's platform bindings (Phase B,
// task 105) — the my:skiko-gfx app/OS-service slices at their
// post-consolidation homes. NOT embedded into any component — the real
// world is wit/wandr-app.wit; this world tells the Kotlin wit-bindgen
// fork what to generate. Regen:
//   wit-bindgen kotlin --kotlin-package-name wandr.platform \
//     -w app-platform wit-platform --out-dir src/wasmWasiMain/kotlin/generated/platform/
//   then DELETE the duplicate cabi_realloc export from the generated
//   runtime/ComponentSupport.kt (skiko's generated runtime already
//   exports it).
package wandr:app-platform;

world app-platform {
    import wandr:device/haptics@0.1.0;
    import wandr:device/power@0.1.0;
    import wandr:device/thermal@0.1.0;
    import wandr:device/sensors@0.1.0;
    import wandr:device/lights@0.1.0;
    import wandr:chrome/launcher@0.1.0;
    import wandr:chrome/status@0.1.0;
    import wandr:chrome/display@0.1.0;
    import wandr:chrome/pointer-icon@0.1.0;
    import wandr:assets/assets@0.1.0;
    import wasi:logging/logging@0.1.0-draft;
    import wasi:audio/pcm@0.0.1;
}
