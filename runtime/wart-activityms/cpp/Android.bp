// wart-activityms — a minimal stub "activity" (IActivityManager) binder service for
// ART-less operation. Lets audioserver/cameraserver (which block on
// waitForService("activity")) finish init with the Java system_server stopped, so
// audio (media.audio_flinger/policy/aaudio) comes back under --no-art. soong
// cc_binary, built on a-03 against the platform libbinder (which exports
// include_activitymanager → binder/IActivityManager.h). Deploy to
// /data/local/tmp/wart-activityms and launch via wart-launch (uid system). See the
// header comment in wart_activityms.cpp.
cc_binary {
    name: "wart-activityms",
    srcs: ["wart_activityms.cpp"],
    shared_libs: [
        "libbinder",
        "libutils",
        "liblog",
        "libbase",
        "libcutils",
    ],
    // a-03's libbinder doesn't re-export include_activitymanager to consumers, so
    // add it for <binder/IActivityManager.h>.
    include_dirs: ["frameworks/native/libs/binder/include_activitymanager"],
    cflags: ["-Wall", "-Wextra", "-Wno-unused-parameter"],
}
