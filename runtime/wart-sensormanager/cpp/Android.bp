// cc_binary, built on a-03. Registers android.frameworks.sensorservice@1.0
// ::ISensorManager (the HIDL wrapper system_server normally publishes) so the
// camera HAL's EIS can reach the gyro under --no-art. See wart_sensormanager.cpp.
cc_binary {
    name: "wart-sensormanager",
    srcs: ["wart_sensormanager.cpp"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    header_libs: ["jni_headers"],
    shared_libs: [
        "libsensorservicehidl",
        "libsensor",
        "libhidlbase",
        "liblog",
        "libutils",
        "libbase",
        "android.frameworks.sensorservice@1.0",
    ],
}
