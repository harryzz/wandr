[submodule "external/skiko"]
	path = external/skiko
	url = https://codeberg.org/harryzz/skiko.git
[submodule "external/wasmtime"]
	path = external/wasmtime
	url = https://codeberg.org/harryzz/wasmtime.git
[submodule "external/compose-multiplatform-core"]
	path = external/compose-multiplatform-core
	url = https://codeberg.org/harryzz/compose-multiplatform-core.git
[submodule "external/kotlin"]
	path = external/kotlin
	url = https://github.com/JetBrains/kotlin.git

# Nested submodules absorbed from wandr-host. These were an
# earlier out-of-tree-libgui attempt that was abandoned
# (see [[project-boot-model-libgui-build]]); the actual libgui
# shim is built on the a-03 AOSP host. Keeping the gitlinks so
# `git submodule status` doesn't error; the working trees are
# not auto-fetched.
[submodule "runtime/wandr-host/vendor/skia-src"]
	path = runtime/wandr-host/vendor/skia-src
	url = https://github.com/rust-skia/skia.git
	shallow = true
[submodule "runtime/wandr-host/vendor/aosp-hardware-interfaces"]
	path = runtime/wandr-host/vendor/aosp-hardware-interfaces
	url = https://android.googlesource.com/platform/hardware/interfaces
	shallow = true
[submodule "runtime/wandr-host/vendor/aosp-frameworks-hardware-interfaces"]
	path = runtime/wandr-host/vendor/aosp-frameworks-hardware-interfaces
	url = https://android.googlesource.com/platform/frameworks/hardware/interfaces
	shallow = true
[submodule "runtime/wandr-host/vendor/aosp-frameworks-av"]
	path = runtime/wandr-host/vendor/aosp-frameworks-av
	url = https://android.googlesource.com/platform/frameworks/av
[submodule "runtime/wandr-host/vendor/aosp-system-hardware-interfaces"]
	path = runtime/wandr-host/vendor/aosp-system-hardware-interfaces
	url = https://android.googlesource.com/platform/system/hardware/interfaces
[submodule "runtime/wandr-host/vendor/aosp-frameworks-native"]
	path = runtime/wandr-host/vendor/aosp-frameworks-native
	url = https://android.googlesource.com/platform/frameworks/native
[submodule "runtime/wandr-host/vendor/aosp-frameworks-base"]
	path = runtime/wandr-host/vendor/aosp-frameworks-base
	url = https://android.googlesource.com/platform/frameworks/base
	shallow = true
[submodule "external/libsignal-service-rs"]
	path = external/libsignal-service-rs
	url = https://codeberg.org/harryzz/libsignal-service-rs.git
	branch = wandr-wasi-transport
[submodule "external/rtc"]
	path = external/rtc
	url = https://github.com/webrtc-rs/rtc
[submodule "runtime/wandr-host/vendor/aosp-packages-modules-dnsresolver"]
	path = runtime/wandr-host/vendor/aosp-packages-modules-dnsresolver
	url = https://android.googlesource.com/platform/packages/modules/DnsResolver
	branch = android15-qpr1-release
[submodule "runtime/wandr-host/vendor/aosp-packages-modules-connectivity"]
	path = runtime/wandr-host/vendor/aosp-packages-modules-connectivity
	url = https://android.googlesource.com/platform/packages/modules/Connectivity
	branch = android15-qpr1-release
[submodule "external/audioclient-rs"]
	path = external/audioclient-rs
	url = https://codeberg.org/harryzz/audioclient-rs.git
[submodule "external/rsbinder"]
	path = external/rsbinder
	url = https://codeberg.org/harryzz/rsbinder.git
	branch = wandr-recursive
[submodule "swift/OpenSwiftUIProject/Compute"]
	path = swift/OpenSwiftUIProject/Compute
	url = https://github.com/harryzz/Compute.git
[submodule "swift/OpenSwiftUIProject/OpenSwiftUI"]
	path = swift/OpenSwiftUIProject/OpenSwiftUI
	url = https://github.com/harryzz/OpenSwiftUI.git
[submodule "swift/OpenSwiftUIProject/OpenAttributeGraph"]
	path = swift/OpenSwiftUIProject/OpenAttributeGraph
	url = https://github.com/harryzz/OpenAttributeGraph.git
[submodule "swift/OpenSwiftUIProject/OpenCoreGraphics"]
	path = swift/OpenSwiftUIProject/OpenCoreGraphics
