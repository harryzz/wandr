[submodule "external/skiko"]
	path = external/skiko
	url = https://codeberg.org/harryzz/skiko.git
[submodule "external/wasmtime"]
	path = external/wasmtime
	url = https://codeberg.org/harryzz/wasmtime.git
[submodule "external/compose-multiplatform-core"]
	path = external/compose-multiplatform-core
	url = https://codeberg.org/harryzz/compose-multiplatform-core.git
[submodule "external/kotlin"]
	path = external/kotlin
	url = https://github.com/JetBrains/kotlin.git

# Nested submodules absorbed from wandr-host. These were an
# earlier out-of-tree-libgui attempt that was abandoned
# (see [[project-boot-model-libgui-build]]); the actual libgui
# shim is built on the a-03 AOSP host. Keeping the gitlinks so
# `git submodule status` doesn't error; the working trees are
# not auto-fetched.
[submodule "external/libsignal-service-rs"]
	path = external/libsignal-service-rs
	url = https://codeberg.org/harryzz/libsignal-service-rs.git
	branch = wandr-wasi-transport
[submodule "external/rtc"]
	path = external/rtc
	url = https://github.com/webrtc-rs/rtc
[submodule "external/audioclient-rs"]
	path = external/audioclient-rs
	url = https://codeberg.org/harryzz/audioclient-rs.git
[submodule "external/rsbinder"]
	path = external/rsbinder
	url = https://codeberg.org/harryzz/rsbinder.git
	branch = wandr-recursive
[submodule "swift/OpenSwiftUIProject/Compute"]
	path = swift/OpenSwiftUIProject/Compute
	url = https://github.com/harryzz/Compute.git
[submodule "swift/OpenSwiftUIProject/OpenSwiftUI"]
	path = swift/OpenSwiftUIProject/OpenSwiftUI
	url = https://github.com/harryzz/OpenSwiftUI.git
[submodule "swift/OpenSwiftUIProject/OpenAttributeGraph"]
	path = swift/OpenSwiftUIProject/OpenAttributeGraph
	url = https://github.com/harryzz/OpenAttributeGraph.git
[submodule "swift/OpenSwiftUIProject/OpenCoreGraphics"]
	path = swift/OpenSwiftUIProject/OpenCoreGraphics
	url = https://github.com/harryzz/OpenCoreGraphics.git
[submodule "swift/OpenSwiftUIProject/OpenObservation"]
	path = swift/OpenSwiftUIProject/OpenObservation
	url = https://github.com/OpenSwiftUIProject/OpenObservation.git
[submodule "swift/OpenSwiftUIProject/OpenRenderBox"]
	path = swift/OpenSwiftUIProject/OpenRenderBox
	url = https://github.com/OpenSwiftUIProject/OpenRenderBox.git
[submodule "runtime/wandr-sensors-client"]
	path = runtime/wandr-sensors-client
	url = https://github.com/harryzz/wandr-sensors-client.git
[submodule "contracts"]
	path = contracts
	url = https://github.com/harryzz/wandr-wit.git
[submodule "runtime/wandr-host"]
	path = runtime/wandr-host
	url = https://github.com/harryzz/wandr-host.git
