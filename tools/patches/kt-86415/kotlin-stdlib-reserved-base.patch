From 1ab69ee7dc4de06922047fee5561a46238af6d9f Mon Sep 17 00:00:00 2001
From: harry <z.zahariev@mishmash.io>
Date: Thu, 21 May 2026 11:39:39 +0300
Subject: [PATCH] stdlib/wasm: start root ScopedMemoryAllocator at 0x20000
 (KT-86415)

Reserve [0,0x20000) of wasm linear memory so the WASI preview1 component
adapter can pin its long-lived State there without it being reused by a
withScopedMemoryAllocator scope. createAllocatorInTheNewScope() starts
the root allocator at RESERVED_BASE=0x20000 instead of 0; destroy() is
left stock so per-call scoped memory is still reclaimed (no leak).

Bumps defaultSnapshotVersion to 2.4.258-SNAPSHOT. Downstream wandr build
patch (task 34); KT-86415 still needs an upstream decision on long-lived
realloc use.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 gradle.properties                                        | 2 +-
 libraries/stdlib/src/kotlin/util/KotlinVersion.kt        | 2 +-
 .../wasm/src/kotlin/wasm/unsafe/MemoryAllocation.kt      | 9 ++++++++-
 3 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/gradle.properties b/gradle.properties
index 2423ddedeb28..a084a102aeaa 100644
--- a/gradle.properties
+++ b/gradle.properties
@@ -22,7 +22,7 @@ systemProp.org.gradle.internal.http.connectionTimeout=90000
 systemProp.org.gradle.internal.http.socketTimeout=90000
 
 cacheRedirectorEnabled=true
-defaultSnapshotVersion=2.4.255-SNAPSHOT
+defaultSnapshotVersion=2.4.258-SNAPSHOT
 # Controls the default Kotlin language version for all the modules
 # There are some local overrides of it:
 # * Convention plugin gradle-plugin-compiler-dependency-configuration.gradle.kts
diff --git a/libraries/stdlib/src/kotlin/util/KotlinVersion.kt b/libraries/stdlib/src/kotlin/util/KotlinVersion.kt
index bce7b3a9ab6f..076e86bcb289 100644
--- a/libraries/stdlib/src/kotlin/util/KotlinVersion.kt
+++ b/libraries/stdlib/src/kotlin/util/KotlinVersion.kt
@@ -79,5 +79,5 @@ public class KotlinVersion(public val major: Int, public val minor: Int, public
 // this class is ignored during classpath normalization when considering whether to recompile dependencies in Kotlin build
 private object KotlinVersionCurrentValue {
     @kotlin.jvm.JvmStatic
-    fun get(): KotlinVersion = KotlinVersion(2, 4, 255) // value is written here automatically during build
+    fun get(): KotlinVersion = KotlinVersion(2, 4, 258) // value is written here automatically during build
 }
diff --git a/libraries/stdlib/wasm/src/kotlin/wasm/unsafe/MemoryAllocation.kt b/libraries/stdlib/wasm/src/kotlin/wasm/unsafe/MemoryAllocation.kt
index baa1f5d4a041..2fae7ac5a19a 100644
--- a/libraries/stdlib/wasm/src/kotlin/wasm/unsafe/MemoryAllocation.kt
+++ b/libraries/stdlib/wasm/src/kotlin/wasm/unsafe/MemoryAllocation.kt
@@ -66,6 +66,13 @@ public inline fun <T> withScopedMemoryAllocator(
     return result
 }
 
+// KT-86415 (wandr task 34): the WASI preview1 component adapter holds a 64 KB
+// `State` block at the fixed address [0x10000, 0x20000). cabi_realloc places
+// nothing there because the root ScopedMemoryAllocator starts at RESERVED_BASE,
+// not 0 — so the adapter's long-lived State can never be reused by a scoped
+// allocation. [0, RESERVED_BASE) is reserved and excluded from this allocator.
+private const val RESERVED_BASE = 0x20000
+
 @PublishedApi
 @UnsafeWasmMemoryApi
 internal fun createAllocatorInTheNewScope(): ScopedMemoryAllocator {
@@ -73,7 +80,7 @@ internal fun createAllocatorInTheNewScope(): ScopedMemoryAllocator {
         "Can't create new allocators while realloc-allocated memory is not freed"
     }
     val allocator = currentAllocator?.createChild() ?:
-        ScopedMemoryAllocator(0, parent = null)
+        ScopedMemoryAllocator(RESERVED_BASE, parent = null)
     currentAllocator = allocator
     return allocator
 }
