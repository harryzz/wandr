// slint-wandr's trimmed copy of the host `my:skiko-gfx` IMPORT surface.
// Since the wasi:canvas port (task: proving consumer), DRAWING comes from
// the wasi:canvas draft (proposals/wasi-canvas, separate generate!) — this
// file keeps only the wandr platform bits: window metrics + IME.
package my:skiko-gfx@0.1.0;

/// density = dpi / 160 — Slint's scale factor.
interface window {
    get-density:    func() -> f32;
    get-font-scale: func() -> f32;
}

/// Soft-keyboard summon/dismiss (task 47 IME model): the guest reports
/// editor focus; the host/arbiter engage the keyboard overlay, and typed
/// text comes back through the regular on-key-event-v2 export.
interface ime {
    notify-editor-attached: func(
        input-type: string,
        hint: string,
        initial-text: string,
        selection-start: u32,
        selection-end: u32,
    );
    notify-editor-detached: func();
}

world slint-wandr-imports {
    import window;
    import ime;
}
