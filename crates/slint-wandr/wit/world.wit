// slint-wandr's import slice of the wandr:ui-shell contract (Phase B —
// the my:skiko-gfx window/ime/theme slices' post-consolidation home).
// Drawing comes from wasi:canvas@0.0.2 (separate generate!) — this file
// keeps only the platform bits: display metrics + IME + theme.
package wandr:ui-shell@0.1.0;

/// density = dpi / 160 — Slint's scale factor.
interface metrics {
    get-density:    func() -> f32;
    get-font-scale: func() -> f32;
    get-dpi:        func() -> u32;
}

/// Soft-keyboard summon/dismiss (task 47 IME model): the guest reports
/// editor focus; the host/arbiter engage the keyboard overlay, and typed
/// text comes back through the regular key-handler export.
interface ime {
    notify-editor-attached: func(
        input-type: string,
        hint: string,
        initial-text: string,
        selection-start: u32,
        selection-end: u32,
    );
    notify-editor-detached: func();
}

/// System UI theme (night mode) — drives Slint's color scheme so the
/// fluent palette matches the platform (dark chrome on wandr).
interface theme {
    enum night-mode { auto, off, on }
    get-night-mode:   func() -> night-mode;
    get-accent-color: func() -> u32;
}

/// Runtime chrome/orientation control (task 120) — dynamic overrides of the
/// static manifest `immersive`/`orientation` flags, forwarded by the host to the
/// arbiter's existing `set-immersive`/`set-orientation-lock` commands. A media app
/// hides chrome + locks orientation during fullscreen playback, restoring on exit.
/// No-op unless this guest is the foreground app (the arbiter keys on the visible app).
interface shell-control {
    /// Hide (true) / show (false) the system chrome (status bar + task bar).
    set-immersive: func(on: bool);
    /// Lock (true) orientation to the current device rotation / unlock (false) → auto-rotate.
    set-orientation-lock: func(on: bool);
}

world slint-wandr-imports {
    import metrics;
    import ime;
    import theme;
    import shell-control;
}
