// wandr:notify — generic user-notification primitive (Signal background-receipt
// subsystem, M3). An app raises a notification via the `notifier` host import;
// the host forwards it to the arbiter, which owns the active list, surfaces it
// in the status bar, and — when the user taps one — foregrounds the owner and
// delivers `on-notification-click(id)` to its `notify-handler` export. Separate
// package (like wandr:alarm / wandr:background) so it carries no skiko-gfx WIT-sync
// obligation. The status-bar read side (`notify-feed`) is added in M3b.

package wandr:notify@0.1.0;

interface notifier {
    /// Raise or replace a notification. `id` is app-assigned; re-posting the same
    /// id replaces the existing one (idempotent). `title`/`body` are plain text.
    post: func(id: u64, title: string, body: string);
    /// Clear a previously-posted notification by its app-assigned `id`.
    cancel: func(id: u64);
}

interface notify-handler {
    /// The user tapped this app's notification `id` (the arbiter also brought the
    /// app to the foreground). The app navigates to the relevant view.
    on-notification-click: func(id: u64);
}

/// The notification surfacer (status bar) imports this to render the active list
/// and report taps. Host-implemented: `list-active` is answered from the arbiter
/// (the host queries `notify-list`); `click` forwards `notify-click <nid>` (the
/// arbiter foregrounds the owner + delivers `on-notification-click`). M3b.
interface notify-feed {
    /// One active notification, as seen by the surfacer. `nid` is the global
    /// arbiter handle — pass it to `click` when the user taps it.
    record notification {
        nid: u64,
        app-id: string,
        title: string,
        body: string,
    }
    list-active: func() -> list<notification>;
    click: func(nid: u64);
}

/// Host-import side — the host implements `notifier` (every guest) + `notify-feed`
/// (the status bar) and add_to_linker's them onto every guest (harmless for ones
/// that don't import them).
world notify-host {
    import notifier;
    import notify-feed;
}

/// Export side — typed `on-notification-click` for guests that export
/// `notify-handler` (probed with `.ok()` per instance, like `alarm-events`).
world notify-events {
    export notify-handler;
}
