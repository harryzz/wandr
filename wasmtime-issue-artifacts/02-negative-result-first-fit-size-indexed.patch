-    /// index.
+    /// index. Used for `dealloc`'s merge-with-address-neighbors lookups.
     free_block_index_to_len: BTreeMap<u32, u32>,
+    /// Parallel index of free blocks sorted by (len, index). Enables O(log F)
+    /// lookup of the smallest free block satisfying a given allocation size
+    /// via `range((alloc_size, 0)..).next()`, replacing the previous O(F)
+    /// linear scan in `first_fit`. Maintained in sync with
+    /// `free_block_index_to_len` via the `add_block` / `remove_block` /
+    /// `update_block_len` helpers — every mutation goes through those.
+    ///
+    /// Policy note: this changes the allocation policy from
+    /// first-fit-by-address to best-fit-by-size (ties broken by lowest
+    /// address).
+    free_block_size_index: BTreeSet<(u32, u32)>,
 }

@@ -50,10 +61,11 @@ impl FreeList {
     /// Create a new `FreeList` for a contiguous region of memory of the given
     /// size.
     pub fn new(capacity: usize) -> Self {
         log::debug!("FreeList::new({capacity})");

         let mut free_list = FreeList {
             capacity,
             free_block_index_to_len: BTreeMap::new(),
+            free_block_size_index: BTreeSet::new(),
         };

         let end = u32::try_from(free_list.capacity).unwrap_or_else(|_| {
@@ -68,13 +80,68 @@ impl FreeList {
         let len = round_u32_down_to_pow2(end.saturating_sub(start), ALIGN_U32);

-        let entire_range = if len >= ALIGN_U32 {
-            Some((start, len))
-        } else {
-            None
-        };
-
-        free_list.free_block_index_to_len.extend(entire_range);
+        if len >= ALIGN_U32 {
+            free_list.add_block(start, len);
+        }

         free_list
     }

+    // Helpers that keep `free_block_index_to_len` and
+    // `free_block_size_index` in lockstep. Every mutation of the free-list
+    // state goes through these.
+
+    fn add_block(&mut self, index: u32, len: u32) {
+        debug_assert_eq!(index % ALIGN_U32, 0);
+        debug_assert_eq!(len % ALIGN_U32, 0);
+        let prev = self.free_block_index_to_len.insert(index, len);
+        debug_assert!(prev.is_none());
+        let inserted = self.free_block_size_index.insert((len, index));
+        debug_assert!(inserted);
+    }
+
+    fn remove_block(&mut self, index: u32) -> u32 {
+        let len = self.free_block_index_to_len.remove(&index)
+            .unwrap_or_else(|| panic!("remove_block: no block at {index:#x}"));
+        let removed = self.free_block_size_index.remove(&(len, index));
+        debug_assert!(removed);
+        len
+    }
+
+    fn update_block_len(&mut self, index: u32, new_len: u32) {
+        debug_assert_eq!(new_len % ALIGN_U32, 0);
+        let slot = self.free_block_index_to_len.get_mut(&index)
+            .unwrap_or_else(|| panic!("update_block_len: no block at {index:#x}"));
+        let old_len = *slot;
+        *slot = new_len;
+        let removed = self.free_block_size_index.remove(&(old_len, index));
+        debug_assert!(removed);
+        let inserted = self.free_block_size_index.insert((new_len, index));
+        debug_assert!(inserted);
+    }
+
@@ -178,15 +245,20 @@ impl FreeList {
-    /// Find the first free block that can hold an allocation of the given size
-    /// and remove it from the free list.
+    /// Find the smallest free block that can hold an allocation of the given
+    /// size and remove it from the free list. Best-fit-by-size, O(log F).
     fn first_fit(&mut self, alloc_size: u32) -> Option<(u32, u32)> {
         debug_assert_eq!(alloc_size % ALIGN_U32, 0);

-        let (&block_index, &block_len) = self
-            .free_block_index_to_len
-            .iter()
-            .find(|(_idx, len)| **len >= alloc_size)?;
+        let &(block_len, block_index) = self
+            .free_block_size_index
+            .range((alloc_size, 0)..)
+            .next()?;

         debug_assert_eq!(block_index % ALIGN_U32, 0);
         debug_assert_eq!(block_len % ALIGN_U32, 0);
+        debug_assert!(block_len >= alloc_size);

-        let entry = self.free_block_index_to_len.remove(&block_index);
-        debug_assert!(entry.is_some());
+        let removed_len = self.remove_block(block_index);
+        debug_assert_eq!(removed_len, block_len);

         Some((block_index, block_len))
     }

@@ -235,7 +307,7 @@ impl FreeList {
-        self.free_block_index_to_len.insert(split_start, split_len);
+        self.add_block(split_start, split_len);

         new_block_len
     }

